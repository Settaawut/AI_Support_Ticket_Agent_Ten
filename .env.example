# Reference list of the environment variables the app reads. It does not load a .env file:
# set them in your shell, e.g.
#   macOS/Linux:  export OPENAI_API_KEY=sk-...
#   PowerShell:   $env:OPENAI_API_KEY = "sk-..."
# Never commit a real key.
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini
# Optional tuning
# TRIAGE_MAX_ITERATIONS=6
# TRIAGE_CONFIDENCE_THRESHOLD=0.6
# TRIAGE_LLM_TIMEOUT_S=30
# TRIAGE_LOG_LEVEL=INFO
# Set to "none" for reasoning models that reject temperature (o-series, gpt-5*)
# TRIAGE_TEMPERATURE=0
